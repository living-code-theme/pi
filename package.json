{
  "name": "@living-code/pi",
  "version": "0.1.1",
  "files": [
    "themes/*.json"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "description": "Living Code for Pi: schema-complete custom themes for messages, tools, thinking levels, syntax, Markdown and HTML exports.",
  "license": "MIT",
  "author": "Living Code",
  "repository": {
    "type": "git",
    "url": "https://github.com/living-code-theme/pi.git"
  },
  "homepage": "https://living-code.dev/ports/pi/",
  "packageManager": "pnpm@12.9.0",
  "engines": {
    "node": ">=22.22"
  },
  "livingCode": {
    "kind": "npm"
  },
  "scripts": {
    "build": "node scripts/generate.mjs",
    "check": "node scripts/check.mjs && python3 scripts/capture.py --check",
    "test": "node scripts/check.mjs && node --test test/*.test.mjs",
    "screenshots": "nix develop path:./capture --command python3 scripts/capture.py",
    "screenshots:check": "python3 scripts/capture.py --check",
    "check:generated": "node scripts/generate.mjs --check",
    "palette:update": "node scripts/update-palette.mjs",
    "package": "node scripts/package.mjs"
  },
  "keywords": [
    "pi-package",
    "theme",
    "living-code"
  ],
  "pi": {
    "image": "https://raw.githubusercontent.com/living-code-theme/pi/main/images/night.png",
    "themes": [
      "themes/*.json"
    ],
    "extensions": [],
    "skills": [],
    "prompts": []
  },
  "devDependencies": {
    "ajv": "8.20.0"
  }
}
